# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://usuario:senha@localhost:5432/realserv_admissao?schema=public"

# ---------------------------------------------------------------------------
# Segurança — gere valores próprios com: openssl rand -base64 32
# ---------------------------------------------------------------------------
# Assina o cookie de sessão e os links temporários de download.
AUTH_SECRET=""
# Chave AES-256 (32 bytes em base64) da criptografia de CPF e RG em repouso.
# ATENÇÃO: trocar esta chave torna ilegíveis os dados já cifrados.
ENCRYPTION_KEY=""

# URL pública da aplicação — usada para montar o link enviado por WhatsApp.
APP_URL="http://localhost:3000"

# Dias de validade do link público do candidato (padrão 30).
DIAS_VALIDADE_LINK="30"

# ---------------------------------------------------------------------------
# Storage dos documentos
# STORAGE_DRIVER=local  -> grava em disco (desenvolvimento)
# STORAGE_DRIVER=s3     -> AWS S3, Cloudflare R2 ou MinIO
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./.uploads"

# S3 / R2 / MinIO (usados quando STORAGE_DRIVER=s3)
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# AWS S3: deixe S3_ENDPOINT vazio.
# Cloudflare R2: https://<accountid>.r2.cloudflarestorage.com
# MinIO local:   http://localhost:9000  (e S3_FORCE_PATH_STYLE=true)
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"

# ---------------------------------------------------------------------------
# Senhas iniciais do seed (opcional — troque no primeiro acesso)
# ---------------------------------------------------------------------------
SENHA_ADMIN=""
SENHA_RECRUTADOR=""
SENHA_DP=""
