APP_NAME="Admissão Real Serv"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://admissao.gruporealserv.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# Hospedagem compartilhada: sem Redis, sem worker. Tudo em arquivo/banco.
LOG_CHANNEL=stack
LOG_LEVEL=error
SESSION_DRIVER=database
SESSION_LIFETIME=480
CACHE_STORE=database
QUEUE_CONNECTION=sync

# ---------------------------------------------------------------------------
# PostgreSQL — dados do painel da KingHost (Gerenciar bancos PgSQL)
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Regras do sistema
# ---------------------------------------------------------------------------
DIAS_VALIDADE_LINK=30
RETENCAO_MESES=6
# Reduz as imagens antes de entrarem no dossiê (memória do php-fpm é limitada).
DOSSIE_MAX_PX=1600
DOSSIE_QUALIDADE_JPEG=78

# Senhas iniciais do seeder (mínimo 8 caracteres). Em branco, usa as padrão.
SENHA_ADMIN=
SENHA_RECRUTADOR=
SENHA_DP=

MAIL_MAILER=log
